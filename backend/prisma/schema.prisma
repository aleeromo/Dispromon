generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String   @id @default(cuid())
  nombre         String   @unique  // identificador único para login (nombre de usuario)
  password       String
  rol            String   // ADMIN | VENTAS | DISENO | TALLER
  itemsAsignado  Item[]   @relation("AsignadoA")
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  categoria_raiz String   @default("PROYECTOS") // PROYECTOS | CLIENTE_GRANDE
  boards         Board[]
  folders        Folder[]
}

model Folder {
  id           String   @id @default(cuid())
  name         String
  position     Int      @default(0)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]  @relation("FolderTree")
  boards       Board[]
}

model Board {
  id               String   @id @default(cuid())
  name             String
  mes_registro     String?  // YYYY-MM (ej. 2026-03) para subdivisión por mes
  nextFolioNumber  Int      @default(1) // contador para OT-YYYY-NNN
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId         String?
  folder           Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  groups           Group[]
  columns          Column[]
}

model Group {
  id        String  @id @default(cuid())
  title     String  @default("Nuevo grupo")
  position  Int     @default(0)
  boardId   String
  board     Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items     Item[]
}

model Item {
  id                      String    @id @default(cuid())
  name                    String    @default("Sin título")
  description             String?   // descripción del proyecto para Hoja de Trabajo
  materials               String?   // materiales para taller (Hoja de Trabajo)
  finalMeasures           String?   // medidas finales para taller (Hoja de Trabajo)
  position                Int       @default(0)
  groupId                 String
  group                   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values                  ItemValue[]
  asignado_a_id           String?
  asignado_a              User?     @relation("AsignadoA", fields: [asignado_a_id], references: [id], onDelete: SetNull)
  estatus_ventas          String?   // Cotizando | Cotización enviada | APROBADO
  estatus_taller          String?   @default("Pendiente") // Pendiente | En Producción | Terminado
  fecha_inicio_produccion DateTime?
  fecha_fin_produccion    DateTime?
}

model Column {
  id          String      @id @default(cuid())
  title       String
  type        String      // status | timeline | people | date | text | file | drive_link
  position    Int         @default(0)
  boardId     String
  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  settings    String?     // JSON: colores status, etc.
  itemValues  ItemValue[]
}

model ItemValue {
  id        String  @id @default(cuid())
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  columnId  String
  column    Column  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  value     String? // JSON según tipo de columna
  @@unique([itemId, columnId])
}

    "db:fix": "node scripts/fix-prisma.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0"
  }
}

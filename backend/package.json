{
  "name": "monday-clone-backend",
  "version": "1.0.0",
  "description": "Backend API para clon de Monday.com",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
